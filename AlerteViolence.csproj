<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- On garde uniquement les cibles mobiles stables -->
		<TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>

		<!-- Cette ligne est désactivée pour contourner le bug Windows -->
		<!-- <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>AlerteViolence</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<ApplicationTitle>AlerteViolence</ApplicationTitle>
		<ApplicationId>com.alerteviolence.app</ApplicationId>
		<ApplicationVersion>1</ApplicationVersion>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.*" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.*" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
	</ItemGroup>

	  <ItemGroup>
    <!-- On exclut le logo du dossier Images pour éviter qu'il ne soit traité deux fois -->
    <MauiImage Include="Resources\Images\*" Exclude="Resources\Images\app_logo.png" />
    
    <!-- On déclare l'icône de l'application depuis son dossier dédié -->
    <MauiIcon Include="Resources\AppIcon\appicon.png" Color="#D32F2F" />
    
    <MauiFont Include="Resources\Fonts\*" />
    <!--  On utilise notre logo comme écran de démarrage avec le fond rouge de l'app -->
	<MauiSplashScreen Include="Resources\Images\app_logo.png" Color="#D32F2F" BaseSize="128,128" />
  </ItemGroup>

	<ItemGroup>
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

</Project>