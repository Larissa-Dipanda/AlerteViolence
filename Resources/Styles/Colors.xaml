<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Palette AlerteViolence -->
    <Color x:Key="PrimaryRed">#D32F2F</Color>
    <Color x:Key="PrimaryGreen">#388E3C</Color>
    <Color x:Key="PrimaryYellow">#FBC02D</Color>

    <!-- Fond sombre (écoconception OLED) -->
    <Color x:Key="BackgroundDark">#121212</Color>
    <Color x:Key="SurfaceDark">#1E1E1E</Color>
    <Color x:Key="SurfaceLight">#2A2A2A</Color>
    <Color x:Key="TextPrimary">#E0E0E0</Color>
    <Color x:Key="TextSecondary">#A0A0A0</Color>
    <Color x:Key="TextMuted">#757575</Color>

</ResourceDictionary>