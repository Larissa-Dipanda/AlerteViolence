<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AlerteViolence.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:AlerteViolence.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="AlerteViolence">

    <!-- Écrans d'authentification -->
    <ShellContent Title="" ContentTemplate="{DataTemplate views:LaunchingPage}" Route="LaunchingPage" />
    <ShellContent Title="" ContentTemplate="{DataTemplate views:EntryPage}" Route="EntryPage" />
    <ShellContent Title="" ContentTemplate="{DataTemplate views:LoginPage}" Route="LoginPage" />
    <ShellContent Title="" ContentTemplate="{DataTemplate views:SignUpPage}" Route="SignUpPage" />

    <!-- Navigation principale -->
    <TabBar Route="MainTabBar">
        <Tab Title="SOS" Icon="sos_icon.png">
            <ShellContent ContentTemplate="{DataTemplate views:SosReportPage}" Route="SosReportPage" />
        </Tab>
        <Tab Title="Contacts" Icon="contacts_icon.png">
            <ShellContent ContentTemplate="{DataTemplate views:EmergencyContactsPage}" Route="EmergencyContactsPage" />
        </Tab>
        <Tab Title="Support" Icon="support_icon.png">
            <ShellContent ContentTemplate="{DataTemplate views:SupportServicesPage}" Route="SupportServicesPage" />
        </Tab>
        <Tab Title="Droits" Icon="rights_icon.png">
            <ShellContent ContentTemplate="{DataTemplate views:RightsPage}" Route="RightsPage" />
        </Tab>
        <Tab Title="Logs" Icon="logs_icon.png">
            <ShellContent ContentTemplate="{DataTemplate views:ReportHistoryPage}" Route="ReportHistoryPage" />
        </Tab>
    </TabBar>

    <!-- Pages de détails et diversion -->
    <ShellContent Title="Calculatrice" ContentTemplate="{DataTemplate views:CalculatricePage}" Route="CalculatricePage" />
    <ShellContent Title="Ending" ContentTemplate="{DataTemplate views:EndingPage}" Route="EndingPage" />

</Shell>