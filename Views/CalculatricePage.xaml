<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlerteViolence.Views.CalculatricePage"
             BackgroundColor="#1A1A1A"
             Title="Calculatrice">

    <Grid Padding="16" RowDefinitions="Auto, *, Auto">

        <!-- Remplacement de Frame par Border -->
        <Border Grid.Row="0" BackgroundColor="#2A2A2A" Stroke="#333333" StrokeThickness="1" Padding="16" Margin="0,0,0,16">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8"/>
            </Border.StrokeShape>
            <Label x:Name="DisplayLabel" Text="0" FontSize="48" TextColor="White" HorizontalTextAlignment="End"/>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" RowDefinitions="*,*,*,*,*" ColumnSpacing="8" RowSpacing="8">
            <Button Grid.Row="0" Grid.Column="0" Text="7" Clicked="OnNumberClicked" BackgroundColor="#3A3A3A" TextColor="White" FontSize="24"/>
            <Button Grid.Row="0" Grid.Column="1" Text="8" Clicked="OnNumberClicked" BackgroundColor="#3A3A3A" TextColor="White" FontSize="24"/>
            <Button Grid.Row="0" Grid.Column="2" Text="9" Clicked="OnNumberClicked" BackgroundColor="#3A3A3A" TextColor="White" FontSize="24"/>
            <Button Grid.Row="0" Grid.Column="3" Text="÷" Clicked="OnOperatorClicked" BackgroundColor="#FF9500" TextColor="White" FontSize="24"/>

            <Button Grid.Row="1" Grid.Column="0" Text="4" Clicked="OnNumberClicked" BackgroundColor="#3A3A3A" TextColor="White" FontSize="24"/>
            <Button Grid.Row="1" Grid.Column="1" Text="5" Clicked="OnNumberClicked" BackgroundColor="#3A3A3A" TextColor="White" FontSize="24"/>
            <Button Grid.Row="1" Grid.Column="2" Text="6" Clicked="OnNumberClicked" BackgroundColor="#3A3A3A" TextColor="White" FontSize="24"/>
            <Button Grid.Row="1" Grid.Column="3" Text="×" Clicked="OnOperatorClicked" BackgroundColor="#FF9500" TextColor="White" FontSize="24"/>

            <Button Grid.Row="2" Grid.Column="0" Text="1" Clicked="OnNumberClicked" BackgroundColor="#3A3A3A" TextColor="White" FontSize="24"/>
            <Button Grid.Row="2" Grid.Column="1" Text="2" Clicked="OnNumberClicked" BackgroundColor="#3A3A3A" TextColor="White" FontSize="24"/>
            <Button Grid.Row="2" Grid.Column="2" Text="3" Clicked="OnNumberClicked" BackgroundColor="#3A3A3A" TextColor="White" FontSize="24"/>
            <Button Grid.Row="2" Grid.Column="3" Text="-" Clicked="OnOperatorClicked" BackgroundColor="#FF9500" TextColor="White" FontSize="24"/>

            <Button Grid.Row="3" Grid.Column="0" Text="0" Clicked="OnNumberClicked" BackgroundColor="#3A3A3A" TextColor="White" FontSize="24"/>
            <Button Grid.Row="3" Grid.Column="1" Text="." Clicked="OnNumberClicked" BackgroundColor="#3A3A3A" TextColor="White" FontSize="24"/>
            <Button Grid.Row="3" Grid.Column="2" Text="=" Clicked="OnEqualsClicked" BackgroundColor="#34C759" TextColor="White" FontSize="24"/>
            <Button Grid.Row="3" Grid.Column="3" Text="+" Clicked="OnOperatorClicked" BackgroundColor="#FF9500" TextColor="White" FontSize="24"/>

            <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Text="C" Clicked="OnClearClicked" BackgroundColor="#FF3B30" TextColor="White" FontSize="24"/>
            <Button Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2" Text="⌫" Clicked="OnBackspaceClicked" BackgroundColor="#3A3A3A" TextColor="White" FontSize="24"/>
        </Grid>

        <Button Grid.Row="2" Text="Quitter" Clicked="OnQuitterClicked" BackgroundColor="Transparent" TextColor="#3A3A3A" FontSize="12" HeightRequest="32" Margin="0,8,0,0"/>
    </Grid>
</ContentPage>