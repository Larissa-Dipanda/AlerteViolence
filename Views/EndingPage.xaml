<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlerteViolence.Views.EndingPage"
             BackgroundColor="{StaticResource PrimaryRed}"
             NavigationPage.HasNavigationBar="False">

    <VerticalStackLayout 
        Padding="32" 
        Spacing="24"
        VerticalOptions="Center"
        HorizontalOptions="Center">

        <Label Text="" 
               FontSize="60" 
               TextColor="White" 
               HorizontalOptions="Center"
               Margin="0,0,0,32"/>

        <Label Text="Même si vous partez !" 
               Style="{StaticResource TitrePrincipal}" 
               HorizontalTextAlignment="Center"
               Margin="0,0,0,16"/>

        <Label Text="N'hésitez jamais à vous exprimer clairement." 
               FontSize="16" 
               TextColor="White" 
               HorizontalTextAlignment="Center"
               Opacity="0.9"/>

    </VerticalStackLayout>
</ContentPage>