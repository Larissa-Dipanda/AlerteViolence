<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlerteViolence.Views.SupportServicesPage"
             BackgroundColor="{StaticResource BackgroundDark}"
             Title="Services de soutien">

    <CollectionView ItemsSource="{Binding Structures}" Margin="16">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border BackgroundColor="{StaticResource SurfaceDark}" 
                        Stroke="#333333" 
                        StrokeThickness="1" 
                        Padding="16" 
                        Margin="0,0,0,8">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8"/>
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding Nom}" FontFamily="IstokWebBold" FontSize="18" TextColor="White"/>
                        <Label Text="{Binding Adresse}" FontSize="14" TextColor="{StaticResource TextSecondary}"/>

                        <!-- C'est cette partie qui rend la carte cliquable et déclenche le popup de détails -->
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStructureClicked" CommandParameter="{Binding .}" />
                        </VerticalStackLayout.GestureRecognizers>
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>