<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlerteViolence.Views.SupportServicesPage"
             BackgroundColor="{StaticResource BackgroundDark}"
             Title="Support services">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label Text="Support services" FontSize="24" TextColor="White" FontAttributes="Bold" Margin="0,16,0,24"/>

            <Frame BackgroundColor="#1E1E1E" CornerRadius="8" Padding="16" BorderColor="#333333">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnServiceTapped" CommandParameter="MINEDUB"/>
                </Frame.GestureRecognizers>
                <Label Text="SOS MINEDUB - Yaounde" FontSize="18" TextColor="White" FontAttributes="Bold"/>
            </Frame>
            <Frame BackgroundColor="#1E1E1E" CornerRadius="8" Padding="16" BorderColor="#333333">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnServiceTapped" CommandParameter="MINEPAT"/>
                </Frame.GestureRecognizers>
                <Label Text="SOS MINEPAT - Yaounde" FontSize="18" TextColor="White" FontAttributes="Bold"/>
            </Frame>
            <Frame BackgroundColor="#1E1E1E" CornerRadius="8" Padding="16" BorderColor="#333333">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnServiceTapped" CommandParameter="MINSUP"/>
                </Frame.GestureRecognizers>
                <Label Text="SOS MINSUP - Yaounde" FontSize="18" TextColor="White" FontAttributes="Bold"/>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>