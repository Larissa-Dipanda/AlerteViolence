<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlerteViolence.Views.EmergencyContactsPage"
             BackgroundColor="{StaticResource BackgroundDark}"
             Title="Emergency Contacts">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label Text="Emergency Contacts" FontSize="24" TextColor="White" FontAttributes="Bold" Margin="0,16,0,24"/>

            <!-- Item 1 -->
            <Frame BackgroundColor="#1E1E1E" CornerRadius="8" Padding="16" BorderColor="#333333">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnContactTapped" CommandParameter="117"/>
                </Frame.GestureRecognizers>
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="16">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="SOS Police" FontSize="18" TextColor="White" FontAttributes="Bold"/>
                        <Label Text="117" FontSize="24" TextColor="{StaticResource PrimaryRed}" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="" FontSize="24" VerticalOptions="Center"/>
                </Grid>
            </Frame>

            <!-- Item 2 -->
            <Frame BackgroundColor="#1E1E1E" CornerRadius="8" Padding="16" BorderColor="#333333">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnContactTapped" CommandParameter="118"/>
                </Frame.GestureRecognizers>
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="16">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="SOS Pompier" FontSize="18" TextColor="White" FontAttributes="Bold"/>
                        <Label Text="118" FontSize="24" TextColor="{StaticResource PrimaryRed}" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="" FontSize="24" VerticalOptions="Center"/>
                </Grid>
            </Frame>

            <!-- Item 3 -->
            <Frame BackgroundColor="#1E1E1E" CornerRadius="8" Padding="16" BorderColor="#333333">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnContactTapped" CommandParameter="115"/>
                </Frame.GestureRecognizers>
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="16">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="SOS Samu" FontSize="18" TextColor="White" FontAttributes="Bold"/>
                        <Label Text="115" FontSize="24" TextColor="{StaticResource PrimaryRed}" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="🚑" FontSize="24" VerticalOptions="Center"/>
                </Grid>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>