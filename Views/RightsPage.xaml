<?xml version="1.0" encoding="utf-8" ?>
<!--  AJOUT : x:Name="RightsPageRoot" pour une référence stable -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlerteViolence.Views.RightsPage"
             x:Name="RightsPageRoot"
             BackgroundColor="{StaticResource BackgroundDark}"
             Title="Droits">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="24">

            <Button Text="Quitter l'app" 
                    Clicked="OnQuickExitClicked" 
                    BackgroundColor="Transparent" 
                    TextColor="{StaticResource TextMuted}" 
                    FontSize="12" 
                    HorizontalOptions="End" 
                    Margin="0,0,0,8"/>

            <Label Text="À propos des droits" FontFamily="IstokWebBold" FontSize="24" TextColor="White" Margin="0,0,0,8"/>

            <Border BackgroundColor="{StaticResource SurfaceDark}" Stroke="#333333" StrokeThickness="1" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label Text="Connaître vos droits" FontFamily="IstokWebBold" FontSize="20" TextColor="{StaticResource PrimaryYellow}"/>
                    <Label Text="Toute personne a le droit de vivre sans violence, abus, intimidation et discrimination." FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{StaticResource SurfaceDark}" Stroke="#333333" StrokeThickness="1" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label Text="Vos droits" FontFamily="IstokWebBold" FontSize="20" TextColor="{StaticResource PrimaryYellow}"/>
                    <Label Text="Vous avez le droit de demander de l'aide, de signaler la violence et d'accéder à des services de soutien." FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{StaticResource SurfaceDark}" Stroke="#333333" StrokeThickness="1" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label Text="Signaler les violences" FontFamily="IstokWebBold" FontSize="20" TextColor="{StaticResource PrimaryYellow}"/>
                    <Label Text="Si vous avez subi ou été témoin de violence, vous pouvez signaler la situation aux autorités compétentes." FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{StaticResource SurfaceDark}" Stroke="#333333" StrokeThickness="1" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label Text="Protection et soutien" FontFamily="IstokWebBold" FontSize="20" TextColor="{StaticResource PrimaryYellow}"/>
                    <Label Text="Les victimes et les témoins peuvent avoir accès à un soutien médical, psychologique, juridique et social." FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                </VerticalStackLayout>
            </Border>

            <Label Text="Textes de loi applicables (Cameroun)" FontFamily="IstokWebBold" FontSize="20" TextColor="White" Margin="0,16,0,8"/>

            <CollectionView ItemsSource="{Binding Lois}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{StaticResource SurfaceDark}" 
                                Stroke="#333333" 
                                StrokeThickness="1" 
                                Padding="16" 
                                Margin="0,0,0,16">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding Article}" FontFamily="IstokWebBold" FontSize="18" TextColor="{StaticResource PrimaryYellow}"/>
                                <Label Text="{Binding Titre}" FontFamily="IstokWebBold" FontSize="16" TextColor="White"/>
                                <Label Text="{Binding Description}" FontSize="14" TextColor="{StaticResource TextSecondary}" LineBreakMode="WordWrap"/>

                                <!--  Utilisation de x:Reference au lieu de RelativeSource -->
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference RightsPageRoot}, Path=BindingContext.OpenLienWebCommand}" 
                                                          CommandParameter="{Binding .}" />
                                </VerticalStackLayout.GestureRecognizers>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>