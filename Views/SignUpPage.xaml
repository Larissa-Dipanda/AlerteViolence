<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlerteViolence.Views.SignUpPage"
             BackgroundColor="{StaticResource BackgroundDark}"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Padding="32" Spacing="24" VerticalOptions="Center">

            <!-- Titre -->
            <Label Text="Sign Up"
                   Style="{StaticResource TitrePage}"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,32"/>

            <!-- Champ Nom -->
            <Entry Placeholder="Jeremy Medou"
                   TextColor="{StaticResource TextPrimary}"
                   PlaceholderColor="{StaticResource TextSecondary}"
                   BackgroundColor="{StaticResource SurfaceDark}"
                   HeightRequest="48"
                   Margin="0,0,0,16"/>

            <!-- Champ Email -->
            <Entry Placeholder="jeremymedou@gmail.com"
                   Keyboard="Email"
                   TextColor="{StaticResource TextPrimary}"
                   PlaceholderColor="{StaticResource TextSecondary}"
                   BackgroundColor="{StaticResource SurfaceDark}"
                   HeightRequest="48"
                   Margin="0,0,0,16"/>

            <!-- Champ Mot de passe -->
            <Entry Placeholder="........"
                   IsPassword="True"
                   TextColor="{StaticResource TextPrimary}"
                   PlaceholderColor="{StaticResource TextSecondary}"
                   BackgroundColor="{StaticResource SurfaceDark}"
                   HeightRequest="48"
                   Margin="0,0,0,24"/>

            <!-- Case à cocher CGU -->
            <HorizontalStackLayout Spacing="12" Margin="0,0,0,32">
                <CheckBox Color="{StaticResource PrimaryRed}" VerticalOptions="Center"/>
                <Label Text="I agree with the terms of policy."
                       TextColor="{StaticResource TextPrimary}"
                       FontSize="14"
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>

            <!-- Bouton Sign Up -->
            <Button Text="Sign Up"
                    Clicked="OnSignUpClicked"
                    BackgroundColor="{StaticResource PrimaryRed}"
                    TextColor="White"
                    FontFamily="InstrumentSansSemiBold"
                    FontSize="16"
                    HeightRequest="48"
                    CornerRadius="8"/>

            <!-- Lien vers Login -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="8" Margin="0,16,0,0">
                <Label Text="Already have an account?"
                       TextColor="{StaticResource TextSecondary}"
                       FontSize="14"
                       VerticalOptions="Center"/>
                <Label Text="Login"
                       TextColor="{StaticResource PrimaryRed}"
                       FontSize="14"
                       FontAttributes="Bold"
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLoginTapped"/>
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>