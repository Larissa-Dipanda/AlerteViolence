<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlerteViolence.Views.ReportDescriptionPage"
             BackgroundColor="{StaticResource BackgroundDark}"
             Title="Description du rapport">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label Text="Description du rapport" FontFamily="IstokWebBold" FontSize="24" TextColor="White"/>

            <Border BackgroundColor="{StaticResource SurfaceDark}" Stroke="#333333" StrokeThickness="1" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">
                    <Label Text="Date : 12/06/2026" FontSize="16" TextColor="White"/>
                    <Label Text="Statut : Victime" FontSize="16" TextColor="White"/>
                    <Label Text="Description : Lorem ipsum dolor sit amet, consectetur adipiscing elit. Toute personne a le droit de vivre sans violence, abus, intimidation et discrimination. Cette application." FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                </VerticalStackLayout>
            </Border>

            <Button Text="Sauvegarder" 
                    Clicked="OnSauvegarderClicked"
                    BackgroundColor="{StaticResource PrimaryRed}" 
                    TextColor="White" 
                    FontFamily="InstrumentSansSemiBold"
                    FontSize="16" 
                    HeightRequest="48" 
                    CornerRadius="8"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>