<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlerteViolence.Views.ReportHistoryPage"
             BackgroundColor="{StaticResource BackgroundDark}"
             Title="Historique">

    <VerticalStackLayout Padding="16">

        <!-- Suppression de FillAndExpand obsolète -->
        <CollectionView ItemsSource="{Binding Rapports}" VerticalOptions="Fill">
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="16">
                    <Label Text="Historique vide !" FontFamily="IstokWebBold" FontSize="24" TextColor="White" HorizontalTextAlignment="Center"/>
                    <Label Text="N'hésitez pas à signaler." FontSize="14" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="{StaticResource SurfaceDark}" Stroke="#333333" StrokeThickness="1" Padding="16" Margin="0,0,0,8">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Numero}" FontFamily="IstokWebBold" FontSize="18" TextColor="{StaticResource PrimaryRed}"/>
                            <Label Text="{Binding Type}" FontSize="14" TextColor="White"/>
                            <Label Text="{Binding Statut}" FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Text="Suppression rapide" Clicked="OnSuppressionRapideClicked" BackgroundColor="{StaticResource PrimaryRed}" TextColor="White" FontFamily="InstrumentSansSemiBold" FontSize="16" HeightRequest="48" CornerRadius="8" Margin="0,16,0,0"/>
    </VerticalStackLayout>
</ContentPage>